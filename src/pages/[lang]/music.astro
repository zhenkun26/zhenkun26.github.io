---
import { t } from '@/i18n';
import PageLayout from '@/layouts/PageLayout.astro';
import { getLocaleStaticPaths } from '../_shared/utils';
export const getStaticPaths = getLocaleStaticPaths;

interface Props {
  locale: string;
}

const { locale } = Astro.props;
---
<PageLayout locale={locale} frontmatter={{ title: t(locale, 'nav.music'), description: t(locale, 'music.description') }}>
  <p>{t(locale, 'music.empty')}</p>
</PageLayout>

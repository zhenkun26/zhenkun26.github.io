---
import CustomContent from '@components/common/CustomContent.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import { Comment } from '@/components/comment';
import { getLocaleFromUrl } from '@/i18n';
import { getContentSite } from '@/i18n/content';
import Layout from './Layout.astro';
import TwoColumnLayout from './TwoColumnLayout.astro';

export interface Props {
  locale?: string;
  frontmatter: {
    title: string;
    description?: string;
    coverTitle?: string;
    comments?: boolean;
  };
}

const { frontmatter, locale = getLocaleFromUrl(Astro.url.pathname) } = Astro.props;
const siteTitle = getContentSite(locale)?.title ?? siteConfig.title;
const showComments = frontmatter.comments ?? true;
---

<Layout locale={locale} title={`${frontmatter.title} | ${siteTitle}`} description={frontmatter.description}>
  <TwoColumnLayout>
    <Cover slot="cover" title={frontmatter.coverTitle ?? frontmatter.title} />
    <HomeSider slot="sider" />
    <div
      class={`shadow-box bg-gradient-start mx-0 flex min-w-0 w-full max-w-full flex-col gap-8 overflow-x-clip ${CONTENT_PADDING.standard}`}
    >
      <div class="prose dark:prose-invert" data-pagefind-body>
        <CustomContent>
          <slot />
        </CustomContent>
      </div>
      {showComments && <Comment />}
    </div>
  </TwoColumnLayout>
</Layout>
